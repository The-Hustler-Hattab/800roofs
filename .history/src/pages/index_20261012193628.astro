---
import { sitePath } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import BusinessDetails from '../components/BusinessDetails.astro';
import { business, services } from '../config/business';
import ProjectPhoto from '../components/ProjectPhoto.astro';
import { projectPhotos } from '../config/projects';
---
<Layout title={`${business.name} | Pittsburgh Roofing, Siding & Gutters`} description="Complete roofing, siding, and gutters in Pittsburgh, PA. Mutual Builders Corporation: over 70 years in business. Financing available. Pennsylvania HIC No. PA010376.">
<section class="hero"><img class="hero-photo" src={sitePath('/images/roofing.webp')} width="1600" height="1067" alt="Architectural rooflines on a residential home; illustrative stock photography" fetchpriority="high"/><div class="wrap"><div class="hero-content"><div class="eyebrow">PITTSBURGH, PA · OWNED BY KEVIN</div><h1>A better exterior.<br/><em>A better feeling<br/>of home.</em></h1><p>Complete roofing, siding, and gutters from Mutual Builders Corporation. Talk with Kevin about your Pittsburgh home. Over 70 years in business.</p><div class="hero-actions"><CallButton/><a class="text-link" href={sitePath('/services/')}>Explore our services →</a></div><div class="hero-note">{business.phoneDisplay || business.phone || 'Kevin’s phone number · awaiting verification'}<br/>Illustrative stock photography. Not a completed 800Roofs.com project.</div></div></div></section>
<div class="strip"><div class="wrap"><span>01 / OVER 70 YEARS IN BUSINESS</span><span>02 / PA HIC NO. {business.hicNumber}</span><span>03 / FINANCING AVAILABLE</span></div></div>
<section class="section wrap"><div class="section-heading"><div><div class="eyebrow">ROOFING · SIDING · GUTTERS</div><h2>Three ways to care<br/>for your home.</h2></div><p>From your roof to your siding and gutters, talk with Kevin about the exterior work your Pittsburgh home needs.</p></div><div class="grid">{services.map((service,i)=><article class="card"><span class="card-number">0{i+1} / EXTERIOR SERVICES</span><h3>{service.title}</h3><p>{service.detail}</p><a href={sitePath(`/services/${service.slug}/`)}>Explore {service.title.toLowerCase()} ↗</a></article>)}</div></section>
<section class="section dark"><div class="wrap split"><div><div class="eyebrow accent">A PERSON BEHIND THE NAME</div><h2>Meet Kevin.<br/>Start with your home.</h2><p class="lede">Mutual Builders Corporation is owned by Kevin and has been in business for over 70 years. Planning roofing, siding, or gutter work? Start a conversation about your Pittsburgh home.</p><a class="text-link" href={sitePath('/about/')}>About Mutual Builders Corporation →</a></div><div><div class="eyebrow accent">WHAT TO DISCUSS</div><div class="steps"><div class="step"><span>01</span><div><strong>Tell Kevin what you’re seeing.</strong><p>Describe leaks, visible wear, or what you’re planning.</p></div></div><div class="step"><span>02</span><div><strong>Ask about your options.</strong><p>Discuss roofing, siding, or gutter options for your home.</p></div></div><div class="step"><span>03</span><div><strong>Understand the scope.</strong><p>Discuss materials, timing, and costs before making a decision.</p></div></div></div></div></div></section>
<section class="section wrap"><div class="section-heading"><div><div class="eyebrow">OUR WORK</div><h2>The difference is in the details.</h2></div><a class="text-link" href={sitePath('/projects/')}>View all our work →</a></div><div class="project-grid photo-grid">{projectPhotos.slice(0, 3).map(photo => <ProjectPhoto photo={photo}/>)}</div><p class="gallery-note">Roof replacements by Kevin. Photos supplied by Kevin; some were taken during installation.</p></section>
<section class="section wrap"><div class="eyebrow">PLAN WITH CONFIDENCE</div><h2>Your project. Your next step.</h2><BusinessDetails/></section>
<section class="cta"><div class="wrap"><div><div class="eyebrow">LET’S TALK ABOUT YOUR HOME</div><h2>A clear next step starts here.</h2><p>{business.cities.length ? `Serving only ${business.cities.join(', ')}.` : 'Service area: awaiting Kevin’s confirmation.'}</p></div><CallButton/></div></section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import { business } from '../config/business';
---
<Layout title="Pittsburgh & Surrounding Areas | Mutual Builders Corporation" description={`${business.name} serves ${business.serviceArea}. Contact Kevin to discuss roofing, siding, or gutter work for your property.`}>
  <section class="page-intro wrap"><div class="eyebrow">PITTSBURGH & SURROUNDING AREAS</div><h1>Exterior services for<br/>your neighborhood.</h1><p class="lede">Serving {business.serviceArea}.</p></section>
  <article class="wrap content"><h2>Our service area</h2><p>Kevin provides complete roofing, siding, and gutter services in {business.serviceArea}. Share your property’s location and describe your project when you call Kevin to confirm service availability for your address.</p><p>Discuss your exterior’s condition, any visible damage, and the next steps for your property. Ask about available financing options.</p><CallButton/></article>
</Layout>

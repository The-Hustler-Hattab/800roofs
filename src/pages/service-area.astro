---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import { business } from '../config/business';
---
<Layout title="Pittsburgh, PA Service Area | Mutual Builders Corporation" description="Mutual Builders Corporation serves Pittsburgh, Pennsylvania only. Contact Kevin to discuss your Pittsburgh property and discuss roofing, siding, or gutter work.">
  <section class="page-intro wrap"><div class="eyebrow">SERVING PITTSBURGH ONLY</div><h1>Exterior services for<br/>Pittsburgh homes.</h1><p class="lede">Kevin’s service area is Pittsburgh, Pennsylvania only.</p></section>
  <article class="wrap content"><h2>Our service area</h2><ul>{business.cities.map(city => <li>{city}</li>)}</ul><p>Have a property in Pittsburgh? Share its location and describe your roofing, siding, or gutter project when you call Kevin. Discuss the exterior’s condition, any visible damage, and the next steps for your property.</p><p>Contact Kevin to discuss your project and available financing options.</p><CallButton/></article>
</Layout>

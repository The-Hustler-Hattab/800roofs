---
import { sitePath } from '../../utils/paths';
import Layout from '../../layouts/Layout.astro';
import { services } from '../../config/business';
---
<Layout title="Roofing, Siding & Gutters | Mutual Builders Corporation" description="Complete roofing, siding, and gutter services in Pittsburgh, PA. Mutual Builders Corporation offers financing. Call Kevin to discuss your home."><section class="page-intro wrap"><div class="eyebrow">ROOFING · SIDING · GUTTERS</div><h1>Care for your home.<br/>From the outside in.</h1><p class="lede">Complete roofing, siding, and gutters for Pittsburgh homes. Discuss your project with Kevin and explore available financing options.</p></section><section class="wrap section"><div class="grid">{services.map(service=><article class="card"><h2>{service.title}</h2><p>{service.detail}</p><a href={sitePath(`/services/${service.slug}/`)}>Explore {service.title.toLowerCase()} →</a></article>)}</div></section></Layout>

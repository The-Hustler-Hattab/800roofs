---
import { sitePath } from '../../utils/paths';
import Layout from '../../layouts/Layout.astro';
import { services } from '../../config/business';
---
<Layout title="Roofing Services | Mutual Builders Corporation" description="Explore proposed roof repair, replacement, and inspection services. Confirm available roofing services directly with Kevin at Mutual Builders Corporation."><section class="page-intro wrap"><div class="eyebrow">ROOFING SERVICES</div><h1>Find your next step.</h1><p class="lede">Every roof has its own condition, materials, and priorities. Explore the considerations that matter for yours.</p><p class="notice">Service offerings are proposed placeholders and must be confirmed by Kevin before launch.</p></section><section class="wrap section"><div class="grid">{services.map(service=><article class="card"><h2>{service.title}</h2><p>{service.detail}</p><a href={sitePath(`/services/${service.slug}/`)}>Read more →</a></article>)}</div></section></Layout>

---
import { sitePath } from '../../utils/paths';
import Layout from '../../layouts/Layout.astro';
import CallButton from '../../components/CallButton.astro';
import BusinessDetails from '../../components/BusinessDetails.astro';
import { services } from '../../config/business';
export function getStaticPaths() { return services.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<Layout title={`${service.title} in Pittsburgh | Mutual Builders Corporation`} description={service.description}><section class="page-intro wrap"><div class="eyebrow">{service.title} · PITTSBURGH, PA</div><h1>{service.intro}</h1></section><article class="wrap content"><p>{service.detail}</p><h2>Topics to discuss with Kevin</h2><ul>{service.points.map(point=><li>{point}</li>)}</ul><h2>Plan your conversation</h2><p>{service.planning} Share your Pittsburgh property’s location and discuss materials, timing, and costs with Kevin.</p><BusinessDetails/><CallButton/><p><a class="text-link" href={sitePath('/services/')}>← All services</a></p></article></Layout>

---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import BusinessDetails from '../components/BusinessDetails.astro';
import { business } from '../config/business';
---
<Layout title={`About Kevin | ${business.name}`} description={`Mutual Builders Corporation is owned by Kevin and has been in business for over 70 years. Serving ${business.serviceArea}.`}>
  <section class="page-intro wrap"><div class="eyebrow">ABOUT {business.name}</div><h1>A local company.<br/>A name you can talk to.</h1></section>
  <article class="wrap content"><p>{business.name} offers complete roofing, siding, and gutters and is owned by Kevin, serving {business.serviceArea}.</p><h2>{business.history}.</h2><p>With over 70 years in business, Mutual Builders Corporation brings a long company history to the conversation about your home’s exterior.</p><p>Whether you’re trying to understand an issue or planning roofing, siding, or gutter work, start by discussing your property and questions with Kevin.</p><BusinessDetails/><p ></p><CallButton/></article>
</Layout>

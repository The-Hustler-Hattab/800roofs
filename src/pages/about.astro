---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import { business } from '../config/business';
---
<Layout title={`About Kevin | ${business.name}`} description="Mutual Builders Corporation is owned by Kevin and has been in business for over 70 years. Serving Pittsburgh, Pennsylvania only.">
  <section class="page-intro wrap"><div class="eyebrow">ABOUT {business.name}</div><h1>A local company.<br/>A name you can talk to.</h1></section>
  <article class="wrap content"><p>{business.name} is a local roofing company owned by Kevin, serving Pittsburgh, Pennsylvania only.</p><h2>{business.history}.</h2><p>With over 70 years in business, Mutual Builders Corporation brings a long company history to the conversation about your roof.</p><p>Whether you’re trying to understand an issue or planning your next roofing project, start by discussing your property and questions with Kevin.</p><p class="notice">Business address, licenses, certifications, and insurance information are awaiting confirmation.</p><CallButton/></article>
</Layout>

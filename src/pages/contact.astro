---
import Layout from '../layouts/Layout.astro';
import BusinessDetails from '../components/BusinessDetails.astro';
import { business } from '../config/business';
---
<Layout title={`Contact Kevin | ${business.name}`} description="Call or email Kevin at Mutual Builders Corporation to discuss roofing, siding, gutters, and financing in Pittsburgh, Pennsylvania. Over 70 years in business.">
  <section class="page-intro wrap"><div class="eyebrow">CONTACT KEVIN</div><h1>Your home.<br/>Let’s talk.</h1></section>
  <article class="wrap content">
    <p>{business.name} serves Pittsburgh, Pennsylvania only.</p>
    {business.phone ? <a class="button" href={`tel:${business.phone}`}>Call Kevin · {business.phoneDisplay || business.phone}</a> : <p class="notice">Kevin’s phone number: awaiting verification.</p>}
    <p>Email Kevin: <a class="text-link" href={`mailto:${business.email}`}>{business.email}</a></p>
    <p>When calling or emailing, share your property location and a brief description of your roofing, siding, or gutter project. Ask about available services and next steps.</p>
    <BusinessDetails/>
  </article>
</Layout>

---
import { sitePath, productionPath } from '../utils/paths';
import '../styles/global.css';
import { business } from '../config/business';
import CallButton from '../components/CallButton.astro';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(productionPath(Astro.url.pathname), business.url);
const schema = { '@context': 'https://schema.org', '@type': 'RoofingContractor', name: business.name, url: business.url, ...(business.phone ? { telephone: business.phone } : {}), ...(business.address ? { address: { '@type': 'PostalAddress', ...business.address } } : {}), ...(business.cities.length ? { areaServed: business.cities.map(name => ({ '@type': 'City', name })) } : {}) };
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="theme-color" content="#142c39"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><link rel="icon" href={sitePath('/favicon.svg')}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/></head>
<body><a href="#main" class="skip">Skip to content</a><header><div class="nav wrap"><a class="brand" href={sitePath('/')} aria-label="800Roofs.com home"><span class="brand-mark">⌂</span><span>800<span class="brand-light">ROOFS</span><small>OWNED BY KEVIN</small></span></a><nav aria-label="Main navigation"><a href={sitePath('/services/')}>Services</a><a href={sitePath('/projects/')}>Our work</a><a href={sitePath('/about/')}>About</a><a href={sitePath('/service-area/')}>Service area</a></nav><CallButton compact/><span class="header-phone">{business.phoneDisplay || business.phone || 'Phone number pending'}</span></div></header><main id="main"><slot/></main><footer><div class="wrap footer-grid"><div><a class="brand" href={sitePath('/')}>800ROOFS<span class="accent">.com</span></a><p>A local roofing company owned by Kevin.</p><p>Serving only {business.cities.join(', ')}.</p></div><div><strong>Let’s talk about your roof.</strong><p>{business.phone ? <a href={`tel:${business.phone}`}>{business.phoneDisplay || business.phone}</a> : 'Phone number: pending verification'}</p><a href={sitePath('/contact/')}>Contact details →</a></div><div><strong>Explore</strong><p><a href={sitePath('/services/')}>Services</a> · <a href={sitePath('/projects/')}>Projects</a></p><a href={sitePath('/service-area/')}>Service area</a></div></div><div class="wrap footer-bottom">© {new Date().getFullYear()} 800Roofs.com <span>Business details and service offerings awaiting Kevin’s confirmation.</span></div></footer><div class="mobile-call"><CallButton/></div></body></html>

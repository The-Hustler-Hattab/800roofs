---
import { business } from '../config/business';
interface Props { class?: string; compact?: boolean }
const { class: className = '', compact = false } = Astro.props;
---
{business.phone ? <a class={`button ${className}`} href={`tel:${business.phone}`} aria-label={`Call Kevin at ${business.phoneDisplay || business.phone}`}>↗ {compact ? 'Call Now' : 'Call Kevin'} · {business.phoneDisplay || business.phone}</a> : <a class={`button ${className}`} href="/contact/">↗ Call Now <span class="pending">Number pending</span></a>}
